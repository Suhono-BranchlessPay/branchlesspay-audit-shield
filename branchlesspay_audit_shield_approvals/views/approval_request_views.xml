<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_approval_request_form_bp" model="ir.ui.view">
        <field name="name">approval.request.form.bp.inherit</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="approvals.approval_request_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="BranchlessPay Audit" name="bp_audit">
                    <field name="bp_anchor_status" widget="statusbar"
                           statusbar_visible="queued,anchored,failed"/>
                    <field name="bp_content_hash" readonly="1"/>
                    <field name="bp_tx_hash" readonly="1"/>
                    <field name="bp_anchor_id" readonly="1"/>
                    <field name="bp_anchored_at" readonly="1"/>
                    <field name="bp_explorer_url" widget="url"/>
                    <button string="Refresh Anchor Status"
                            type="object"
                            name="action_bp_refresh_anchor_status"
                            class="btn-primary"
                            invisible="not bp_anchor_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
